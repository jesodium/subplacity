{
  "name": "subplacity",
  "productName": "Subplacity",
  "version": "1.1.0",
  "description": "roblox subplace finder",
  "main": "main.js",
  "author": "misunderstood",
  "license": "EPL-2.0",
  "scripts": {
    "start": "electron .",
    "test:update": "electron . --fake-version=0.0.0",
    "dist": "electron-builder -mw"
  },
  "build": {
    "appId": "com.misunderstood.subplacity",
    "productName": "Subplacity",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Subplacity"
    }
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "electron-updater": "^6.8.9"
  }
}
